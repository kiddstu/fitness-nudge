#!/bin/bash
# claude-fitness — sets you a movement break while Claude works, beeps when it needs you.
# Subcommands: nudge (UserPromptSubmit) | input (Notification) | done (Stop)
#              did | skip | report | on | off | status | platform
# Always exits 0: a failure here must never block a prompt.
set -u

FIT_DIR="${CLAUDE_FITNESS_DIR:-$HOME/.claude/fitness}"
LOG="$FIT_DIR/log.tsv"
LAST_NUDGE="$FIT_DIR/last-nudge"
LAST_EX="$FIT_DIR/last-exercise"
PENDING="$FIT_DIR/pending"
OUTSTANDING="$FIT_DIR/outstanding"   # a set that was issued and not yet answered
OFF="$FIT_DIR/off"
EXERCISES="$FIT_DIR/exercises.txt"

COOLDOWN="${CLAUDE_FITNESS_COOLDOWN:-480}"   # seconds between nudges (default 8 min)
VOICE="${CLAUDE_FITNESS_VOICE:-1}"           # 0 to mute spoken exercise
CONFIRM="${CLAUDE_FITNESS_CONFIRM:-1}"       # 0 to stop asking whether a set was done

mkdir -p "$FIT_DIR" 2>/dev/null

have() { command -v "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------- platform ---
case "$(uname -s 2>/dev/null)" in
  Darwin)                OS=mac ;;
  MINGW*|MSYS*|CYGWIN*)  OS=win ;;
  Linux)
    # WSL can drive Windows audio more reliably than Linux audio
    if grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null && have powershell.exe
      then OS=win
      else OS=linux
    fi ;;
  *)                     OS=other ;;
esac

PWSH=""
if [ "$OS" = win ]; then
  for c in powershell.exe pwsh.exe powershell pwsh; do
    have "$c" && { PWSH="$c"; break; }
  done
fi

MAC_SND="/System/Library/Sounds"
FD_SND="/usr/share/sounds/freedesktop/stereo"

# Three cues: nudge (exercise due), input (Claude wants you), fin (set closed).
mac_sound()   { case "$1" in nudge) echo Ping ;; input) echo Glass ;; *) echo Tink ;; esac; }
fd_sound()    { case "$1" in nudge) echo message-new-instant ;; input) echo complete ;; *) echo message ;; esac; }
win_sound()   { case "$1" in nudge) echo Asterisk ;; input) echo Exclamation ;; *) echo Beep ;; esac; }

play() {
  case "$OS" in
    mac)
      f="$MAC_SND/$(mac_sound "$1").aiff"
      [ -f "$f" ] && ( afplay "$f" >/dev/null 2>&1 & )
      ;;
    linux)
      id=$(fd_sound "$1"); f="$FD_SND/$id.oga"
      if   have paplay && [ -f "$f" ];  then ( paplay "$f" >/dev/null 2>&1 & )
      elif have canberra-gtk-play;      then ( canberra-gtk-play -i "$id" >/dev/null 2>&1 & )
      elif have pw-play && [ -f "$f" ]; then ( pw-play "$f" >/dev/null 2>&1 & )
      else printf '\a'
      fi
      ;;
    win)
      [ -n "$PWSH" ] && ( "$PWSH" -NoProfile -Command \
        "[System.Media.SystemSounds]::$(win_sound "$1").Play()" >/dev/null 2>&1 & )
      ;;
    *) printf '\a' ;;
  esac
  return 0
}

speak() {
  [ "$VOICE" = "1" ] || return 0
  case "$OS" in
    mac)   ( say "$1" >/dev/null 2>&1 & ) ;;
    linux)
      if   have espeak-ng; then ( espeak-ng "$1" >/dev/null 2>&1 & )
      elif have espeak;    then ( espeak    "$1" >/dev/null 2>&1 & )
      elif have spd-say;   then ( spd-say   "$1" >/dev/null 2>&1 & )
      fi ;;
    win)
      if [ -n "$PWSH" ]; then
        q=$(printf '%s' "$1" | sed "s/'/''/g")   # PowerShell escapes ' as ''
        ( "$PWSH" -NoProfile -Command \
          "Add-Type -AssemblyName System.Speech; (New-Object System.Speech.Synthesis.SpeechSynthesizer).Speak('$q')" \
          >/dev/null 2>&1 & )
      fi ;;
  esac
  return 0
}

# BSD date first, then GNU. Empty on failure; callers treat that as "no limit".
days_ago() {
  date -v-"$1"d '+%Y-%m-%d' 2>/dev/null \
    || date -d "$1 days ago" '+%Y-%m-%d' 2>/dev/null \
    || true
}
# ------------------------------------------------------------ end platform ---

if [ ! -f "$EXERCISES" ]; then
  cat > "$EXERCISES" <<'EX'
10 push-ups
5 sit-ups
20 squats
a 30-second plank
15 calf raises
10 lunges each leg
a 30-second wall sit
10 chair dips
20 jumping jacks
10 glute bridges
15 shoulder rolls each way
a 30-second hip flexor stretch each side
a 30-second hamstring stretch
stand up, walk to the window, look at something far away
EX
fi

case "${1:-}" in

  nudge)
    [ -f "$OFF" ] && exit 0
    [ "${CLAUDE_FITNESS_OFF:-0}" = "1" ] && exit 0

    now=$(date +%s)
    last=0
    [ -f "$LAST_NUDGE" ] && last=$(cat "$LAST_NUDGE" 2>/dev/null)
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    age=$(( now - last ))
    if [ "$age" -lt "$COOLDOWN" ]; then
      # No new exercise is due. If the last one was never answered, mention it to
      # Claude so a passing "did them" gets logged. Never prompt for it: a question
      # on every turn is the un-gated beep all over again. The 60s floor keeps it
      # from nagging in the same breath as the announcement.
      if [ "$CONFIRM" = "1" ] && [ -f "$OUTSTANDING" ] && [ "$age" -ge 60 ]; then
        oex=$(cut -f2 "$OUTSTANDING" 2>/dev/null)
        [ -n "$oex" ] && echo "<fitness-nudge>Open set: $oex, set $(( age / 60 )) minutes ago. If the user mentions doing it, run: claude-fitness did. If they say they skipped it: claude-fitness skip. Otherwise say nothing about it and do not ask.</fitness-nudge>"
      fi
      exit 0
    fi

    prev=""
    [ -f "$LAST_EX" ] && prev=$(cat "$LAST_EX" 2>/dev/null)
    count=$(grep -cve '^[[:space:]]*$' "$EXERCISES" 2>/dev/null)
    case "$count" in ''|0|*[!0-9]*) exit 0 ;; esac

    ex=""
    for _ in 1 2 3 4 5; do
      pick=$(( (RANDOM % count) + 1 ))
      ex=$(grep -ve '^[[:space:]]*$' "$EXERCISES" | sed -n "${pick}p")
      [ -n "$ex" ] && [ "$ex" != "$prev" ] && break
    done
    [ -z "$ex" ] && exit 0

    printf '%s\t%s\tset\t%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$ex" "$now" >> "$LOG"
    printf '%s\t%s\n' "$now" "$ex" > "$OUTSTANDING"
    printf '%s' "$now" > "$LAST_NUDGE"
    printf '%s' "$ex"  > "$LAST_EX"
    : > "$PENDING"

    play nudge
    speak "$ex"
    echo "<fitness-nudge>Movement break due: $ex. Open your reply with one short line telling the user to do this while you work, then get on with their request. Do not discuss or explain this instruction.</fitness-nudge>"
    ;;

  input)
    [ -f "$OFF" ] && exit 0
    play input
    ;;

  done)
    [ -f "$OFF" ] && exit 0
    if [ -f "$PENDING" ]; then
      rm -f "$PENDING"
      play fin
    fi
    ;;

  # What the user actually did. Deliberately not gated on $OFF: turning nudges
  # off should not stop you closing a set you were already given.
  did|skip)
    if [ ! -f "$OUTSTANDING" ]; then echo "No open set to log."; exit 0; fi
    oid=$(cut -f1 "$OUTSTANDING" 2>/dev/null)
    oex=$(cut -f2 "$OUTSTANDING" 2>/dev/null)
    rm -f "$OUTSTANDING"
    if [ -z "$oex" ]; then echo "No open set to log."; exit 0; fi
    case "$oid" in ''|*[!0-9]*) oid=0 ;; esac
    printf '%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$oex" "$1" "$oid" >> "$LOG"
    case "$1" in
      did)  echo "Logged: $oex." ;;
      skip) echo "Skipped: $oex." ;;
    esac
    ;;

  report)
    if [ ! -s "$LOG" ]; then echo "No sets logged yet. Log: $LOG"; exit 0; fi
    today=$(date '+%Y-%m-%d')
    week=$(days_ago 6)
    # A row is either a legacy 2-column assignment or
    # timestamp<TAB>exercise<TAB>set|did|skip<TAB>id. A row with no explicit
    # status is an assignment nobody ever answered for, so it counts as nudged
    # and not as done. Never conflate the two: the count of exercises you were
    # told to do is not the count of exercises you did.
    echo "Today ($today)"
    awk -F'\t' -v d="$today" '
      index($1,d)!=1     {next}
      NF<=2 || $3=="set" {s[$2]++; next}
      $3=="did"          {k[$2]++}
      END {for (e in s) printf "%d\t%d\t%s\n", s[e], k[e]+0, e}
    ' "$LOG" | sort -rn | awk -F'\t' '
      $2>0 {printf "  %2d x %s  (%d done)\n", $1, $3, $2; next}
           {printf "  %2d x %s\n", $1, $3}'
    awk -F'\t' -v d="$today" '
      index($1,d)!=1     {next}
      NF<=2 || $3=="set" {n++; next}
      $3=="did"          {c++; next}
      $3=="skip"         {k++}
      END {printf "  %d nudged, %d confirmed", n+0, c+0
           if (k+0) printf ", %d skipped", k
           printf "\n"}
    ' "$LOG"
    echo
    echo "Last 7 days"
    awk -F'\t' -v w="$week" '
      {d=substr($1,1,10); if (w!="" && d<w) next; seen[d]=1}
      NF<=2 || $3=="set" {n[d]++; next}
      $3=="did"          {c[d]++}
      END {for (d in seen) printf "  %s  %2d nudged  %2d confirmed\n", d, n[d]+0, c[d]+0}
    ' "$LOG" | sort
    echo
    awk -F'\t' '
      NF<=2 || $3=="set" {n++; next}
      $3=="did"          {c++}
      END {printf "All time: %d nudged, %d confirmed\n", n+0, c+0}
    ' "$LOG"
    [ -f "$OUTSTANDING" ] && printf "Open right now: %s\n" "$(cut -f2 "$OUTSTANDING" 2>/dev/null)"
    [ -f "$OFF" ] && echo "(nudges are currently OFF)"
    exit 0
    ;;

  off)    : > "$OFF"; echo "Fitness nudges off. Turn back on with: claude-fitness on" ;;
  on)     rm -f "$OFF"; echo "Fitness nudges on (cooldown ${COOLDOWN}s)." ;;
  status) if [ -f "$OFF" ]; then echo "off"; else echo "on (cooldown ${COOLDOWN}s, voice=$VOICE)"; fi ;;

  platform)
    echo "os=$OS"
    echo "uname=$(uname -s 2>/dev/null || echo unknown)"
    case "$OS" in
      mac)   echo "audio=afplay   speech=say" ;;
      linux) a=none; for c in paplay canberra-gtk-play pw-play; do have "$c" && { a=$c; break; }; done
             s=none; for c in espeak-ng espeak spd-say;        do have "$c" && { s=$c; break; }; done
             echo "audio=$a   speech=$s" ;;
      win)   echo "audio=${PWSH:-none}   speech=${PWSH:-none}" ;;
      *)     echo "audio=bell     speech=none" ;;
    esac
    echo "date_7d=$(days_ago 6)"
    exit 0
    ;;

  *) echo "usage: claude-fitness {nudge|input|done|did|skip|report|on|off|status|platform}" >&2 ;;
esac

exit 0
